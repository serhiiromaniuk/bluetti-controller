*.pcap
*.pcapng

# Agent-readiness renders (score.json and report.md are committed)
.agent-readiness/report.html
.agent-readiness/report.pdf

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store

# Release tarballs (make dist)
/dist/

# Machine-local Claude Code settings (personal permissions)
.claude/settings.local.json

# One-off agent-readiness audit output (toolkit:agent-readiness)
/.agent-readiness/

# Other coding agents' sandbox mount points (empty; never commit)
/.agents/
/.aws/
/.codex/
